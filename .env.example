SUPABASE_DB_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-password-here
SUPABASE_DB_SSLMODE=require
SESSION_SECRET=change-this-to-a-long-random-string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=PharmaLink
# HTTPS email for Render free (SMTP ports 465/587 are blocked there).
RESEND_API_KEY=
RESEND_FROM=PharmaLink <pharmalink.ph32@gmail.com>

# PayMongo e-wallet (GCash / Maya). Use live keys in production.
PAYMONGO_MODE=live
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_PUBLIC_KEY=
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_PUBLIC_KEY=
PAYMONGO_BASE_URL=http://127.0.0.1:8080
